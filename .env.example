# Configuración de base de datos PostgreSQL
# En local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestion
# En la nube (ejemplo Supabase / Neon):
# DATABASE_URL=postgresql://postgres.xxx:tu_clave@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Clave secreta para sesiones (opcional; si se omite, se genera una automáticamente en .secret_key)
# SECRET_KEY=tu_clave_secreta_aleatoria_aqui
